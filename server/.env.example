# Server Port
PORT=6969

# Client & Server Origins
URL_CLIENT=http://localhost:80
CLIENT_URL=http://localhost:80
SERVER_URL=http://localhost:6969
BASE_URL=http://localhost:6969

# Environment Settings
NODE_ENV=development
STAGE_ENV=development
TRUST_PROXY=1

# Session & Security (Must be at least 32 characters in production)
SESSION_SECRET=your_super_secret_session_key_minimum_32_chars_long

# Redis Configuration (Required with rediss:// in production, optional in local development)
REDIS_URL=redis://redis:6379

# Stytch Authentication
STYTCH_PROJECT_ID=project-test-xxxx
STYTCH_SECRET=secret-test-xxxx
STYTCH_ENV=test

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# AWS RDS Database (Used when connecting to AWS MySQL)
AWS_DB_NAME=Dev_Connect_Db
AWS_DB_USER=admin
AWS_DB_MP=your_db_password
AWS_DB_HOST=database-1.cshgkwao4u6x.us-east-1.rds.amazonaws.com
DB_PORT=3306
# DB_SSL_CA= (Required in production for RDS TLS validation)

# Local MySQL (Alternative fallback if not using AWS RDS)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=devs_connect
MYSQL_PORT=3306

# AWS S3 (Cloud Storage for file uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=us-east-1

